{
  "name": "first-pcb",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:course": "node --experimental-strip-types scripts/check-course.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && node scripts/package-windows.mjs portable",
    "installer:win": "npm run build && node scripts/package-windows.mjs nsis",
    "test:learning": "node --experimental-strip-types --test scripts/test-learning.mjs",
    "test:ui": "node --experimental-strip-types scripts/test-learning-ui.mjs",
    "test:desktop": "node --experimental-strip-types scripts/test-learning-desktop.mjs",
    "test:language": "node --experimental-strip-types scripts/test-learning-language.mjs",
    "test:recovery": "node --experimental-strip-types scripts/test-learning-recovery.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.firstpcb.learning",
    "productName": "First PCB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "First-PCB-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
